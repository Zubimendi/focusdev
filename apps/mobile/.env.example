# Copy to .env (and optionally .env.local — that overrides .env).
# Physical device or Expo Go: use your Wi‑Fi IP, e.g. http://192.168.0.129:3000/api
# Android emulator only: http://10.0.2.2:3000/api
# iOS simulator only: http://localhost:3000/api
#
# Auth parity: this URL must hit the same Next.js API that uses MONGODB_URI
# in apps/web/.env.local (local web + mobile share one database).
# Restart Expo with -c after changing the URL.
EXPO_PUBLIC_API_URL=http://192.168.0.129:3000/api

# Shared with mobile: both apps must use the same MONGODB_URI for auth parity.
# Mobile hits this Next API via EXPO_PUBLIC_API_URL (LAN IP → localhost:3000).
MONGODB_URI=mongodb://localhost:27017/focus
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
# Optional — password reset emails. Without this, reset links are logged server-side in dev.
# RESEND_API_KEY=
# EMAIL_FROM=FocusDev <onboarding@resend.dev>
